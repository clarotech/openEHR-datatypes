<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>OpenEHR.RM.DataTypes</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata -->
    <PackageId>Clarotech.OpenEHR.RM.Datatypes</PackageId>
    <Version>1.1.2</Version>
    <Authors>Clarotech</Authors>
    <Description>C# implementation of the openEHR Reference Model Release 1.1.0 Data Types specification.</Description>
    <PackageTags>openehr;ehr;datatypes;healthcare;hl7;rm</PackageTags>
    <PackageProjectUrl>https://github.com/clarotech/openEHR-datatypes</PackageProjectUrl>
    <RepositoryUrl>https://github.com/clarotech/openEHR-datatypes.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\README.md')" />
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" Condition="Exists('..\LICENSE.txt')" />
    <None Include="..\icon.png" Pack="true" PackagePath="\" Condition="Exists('..\icon.png')" />
  </ItemGroup>

</Project>
